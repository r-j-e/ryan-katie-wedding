# Files in the repo root that shouldn't be served as static assets at
# katieandryan.co.uk. Worker source + schema + repo docs.
src
schema.sql
*.md
.assetsignore
# JSX sources — esbuild compiles these into dist/*.js during the build
# step (see wrangler.jsonc#build.command); browsers load the compiled JS.
*.jsx
# Build / npm noise.
node_modules
.npm
package.json
package-lock.json
